---
import { site, footerLinks } from '../data/site';
const year = new Date().getFullYear();
---

<footer class="ftr" id="contact">
  <div class="grid">
    <div class="ftr__inner">
      <p class="ftr__mark">{site.name}</p>
      <p class="ftr__legal">
        Copyright {year} {site.name}, licensed under the {site.license} license.
      </p>
      <p class="ftr__links">
        {
          footerLinks.map((l) => (
            <a href={l.href} rel="me">
              [{l.label}]
            </a>
          ))
        }
      </p>
    </div>
  </div>
</footer>

<style>
  .ftr {
    padding-block: var(--space-8);
    scroll-margin-top: var(--space-section);
  }

  .ftr__inner {
    grid-column: 1 / span 8;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .ftr__mark {
    font-family: var(--face-display);
    font-size: clamp(1.4rem, 1rem + 1.4vw, 2rem);
    line-height: 1;
    color: var(--ink-2);
  }

  .ftr__legal {
    font-size: var(--t-small);
    color: var(--ink-2);
  }

  .ftr__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    font-size: var(--t-small);
  }

  .ftr__links a { text-decoration: none; color: var(--ink-1); }

  @media (max-width: 860px) {
    .ftr__inner { grid-column: 1 / -1; }
  }
</style>
